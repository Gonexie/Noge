// The longest Collatz chain below 3,000,000: tight loop, division, remainder, checked u64 arithmetic.
fn main() -> i32 {
    var best_n: u64 = 1;
    var best_steps: u64 = 0;
    var n: u64 = 1;
    while n <= 3000000 {
        var x: u64 = n;
        var steps: u64 = 0;
        while x != 1 {
            if x % 2 == 0 { x = x / 2; } else { x = 3 * x + 1; }
            steps = steps + 1;
        }
        if steps > best_steps { best_steps = steps; best_n = n; }
        n = n + 1;
    }
    print(best_n as i32);
    print(best_steps as i32);
    return 0;
}
