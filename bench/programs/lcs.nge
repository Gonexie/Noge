// Longest common subsequence of two 15,000-byte strings: a dynamic program of 225 million cells, two rolling rows.
fn main() -> i32 {
    var s: [u8; 15000] = [0; 15000];
    var t: [u8; 15000] = [0; 15000];
    var x: u32 = 7;
    var i: usize = 0;
    while i < 15000 {
        x = wrapping_add(wrapping_mul(x, 1664525), 1013904223);
        s[i] = ((x >> 24) % 4) as u8;
        x = wrapping_add(wrapping_mul(x, 1664525), 1013904223);
        t[i] = ((x >> 24) % 4) as u8;
        i = i + 1;
    }
    var rows: [u32; 30002] = [0; 30002];
    var prev: usize = 0;
    var cur: usize = 15001;
    i = 1;
    while i <= 15000 {
        rows[cur] = 0;
        var j: usize = 1;
        while j <= 15000 {
            if s[i - 1] == t[j - 1] {
                rows[cur + j] = rows[prev + j - 1] + 1;
            } else if rows[prev + j] >= rows[cur + j - 1] {
                rows[cur + j] = rows[prev + j];
            } else {
                rows[cur + j] = rows[cur + j - 1];
            }
            j = j + 1;
        }
        let tmp = prev;
        prev = cur;
        cur = tmp;
        i = i + 1;
    }
    print(rows[prev + 15000] as i32);
    return 0;
}
