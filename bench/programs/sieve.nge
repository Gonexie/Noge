// Sieve of Eratosthenes up to 20,000,000: a 20 MB array, bounds-checked stores and loads.
fn main() -> i32 {
    var is_prime: [bool; 20000001] = [true; 20000001];
    is_prime[0] = false;
    is_prime[1] = false;
    var i: usize = 2;
    while i * i <= 20000000 {
        if is_prime[i] {
            var j: usize = i * i;
            while j <= 20000000 {
                is_prime[j] = false;
                j = j + i;
            }
        }
        i = i + 1;
    }
    var count: u32 = 0;
    var k: usize = 0;
    while k <= 20000000 {
        if is_prime[k] { count = count + 1; }
        k = k + 1;
    }
    print(count as i32);
    return 0;
}
