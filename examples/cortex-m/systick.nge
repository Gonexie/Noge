// An interrupt handler written in Noge. `export "C" fn` gives the function the plain C name SysTick_Handler,
// which replaces the weak default in the vector table (startup.c). The tick counter is a static of this program: a
// `static mut volatile`, so that the main program's loop reads it again each time round instead of keeping it in a
// register. Using a `static mut` is unsafe, as it is shared with code that can run at any moment.
extern "C" fn semihost_puts(s: *const u8);
extern "C" fn semihost_exit(code: i32);

static mut volatile TICKS: u32 = 0;

const SYST_CSR: usize = 0xE000_E010;
const SYST_RVR: usize = 0xE000_E014;
const SYST_CVR: usize = 0xE000_E018;

fn reg_write(addr: usize, value: u32) {
    unsafe { volatile_write(addr as *mut u32, value); }
}

export "C" fn SysTick_Handler() {
    unsafe { TICKS = TICKS + 1; }
}

fn main() -> i32 {
    reg_write(SYST_RVR, 7999);
    reg_write(SYST_CVR, 0);
    reg_write(SYST_CSR, 0b111);          // enabled, CPU clock, interrupt on every wrap
    unsafe {
        while TICKS < 10 { }             // wait for the handler to count ten
        semihost_puts(c"ten ticks counted by the handler\n");
        semihost_exit(0);
    }
    return 0;
}
