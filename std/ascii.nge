// Characters as bytes:   import "std/ascii.nge" as ascii;     ascii::is_digit(c)     ascii::to_upper(c)
//
// Noge has no character type: a character is a u8 holding its ASCII code, and 'a' is that number written as a
// character. Only the ASCII range is looked at; every byte of 128 or above is "none of the above".

pub fn is_digit(c: u8) -> bool { return c >= '0' && c <= '9'; }
pub fn is_lower(c: u8) -> bool { return c >= 'a' && c <= 'z'; }
pub fn is_upper(c: u8) -> bool { return c >= 'A' && c <= 'Z'; }
pub fn is_alpha(c: u8) -> bool { return is_lower(c) || is_upper(c); }
pub fn is_alnum(c: u8) -> bool { return is_alpha(c) || is_digit(c); }
pub fn is_hex_digit(c: u8) -> bool { return is_digit(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F'); }

// space, tab, newline, vertical tab, form feed, carriage return
pub fn is_space(c: u8) -> bool { return c == ' ' || (c >= 9 && c <= 13); }

// a control character (0 to 31, and 127)
pub fn is_control(c: u8) -> bool { return c < 32 || c == 127; }

// a visible character or the space: 32 to 126
pub fn is_print(c: u8) -> bool { return c >= 32 && c <= 126; }

// visible, and not a letter, digit or space
pub fn is_punct(c: u8) -> bool { return c > 32 && c <= 126 && !is_alnum(c); }

pub fn to_upper(c: u8) -> u8 {
    if is_lower(c) { return c - 32; }
    return c;
}

pub fn to_lower(c: u8) -> u8 {
    if is_upper(c) { return c + 32; }
    return c;
}

// '0' to '9' as 0 to 9
pub fn digit_value(c: u8) -> Option<u32> {
    if is_digit(c) { return Option::Some((c - '0') as u32); }
    return Option::None;
}

// '0'-'9', 'a'-'f' and 'A'-'F' as 0 to 15
pub fn hex_value(c: u8) -> Option<u32> {
    if is_digit(c) { return Option::Some((c - '0') as u32); }
    if c >= 'a' && c <= 'f' { return Option::Some((c - 'a') as u32 + 10); }
    if c >= 'A' && c <= 'F' { return Option::Some((c - 'A') as u32 + 10); }
    return Option::None;
}

// 0 to 15 as '0'-'9' and 'a'-'f' (only the low 4 bits of v count)
pub fn hex_digit(v: u32) -> u8 {
    let d = (v & 15) as u8;
    if d < 10 { return '0' + d; }
    return 'a' + (d - 10);
}
