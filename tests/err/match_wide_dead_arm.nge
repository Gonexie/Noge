// error: this arm can never match
// A variant with many bool values: finding the dead arm used to try every combination (seconds for 22, hours for 30).
enum E { V(bool, bool, bool, bool, bool, bool, bool, bool, bool, bool, bool, bool, bool, bool, bool, bool, bool, bool, bool, bool, bool, bool), W }
fn f(e: E) -> i32 {
    return match e {
        E::V(true, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) => 0,
        E::V(false, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) => 0,
        E::V(_, true, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) => 1,
