fn main() -> i32 {
    let x: u8 = 0xF0;
    let y: u8 = 0x3C;
    print((x & y) as i32);            // 0x30 = 48
    print((x | y) as i32);            // 0xFC = 252
    print((x ^ y) as i32);            // 0xCC = 204
    print((~x) as i32);               // 0x0F = 15
    print((x >> 4) as i32);           // 15
    print((y << 2) as i32);           // 0xF0 = 240
    let s: i32 = -16;
    print(s >> 2);                    // arithmetic shift: -4
    print(s << 2);                    // -64
    print(~s);                        // 15
    let m: u32 = 0xFFFFFFFF;
    print((m >> 31) as i32);          // 1
    print((m & 0xFF) as i32);         // 255
    let one: i64 = 1;
    print((one << 40 >> 38) as i32);  // 4
    if x & 0x80 == 0x80 { print(1); } else { print(0); }   // & binds tighter than ==: 1
    if 1 + 2 << 1 == 6 { print(1); } else { print(0); }    // + binds tighter than <<: 1
    if 1 | 2 ^ 3 & 1 == 3 { print(1); } else { print(0); } // 1 | (2 ^ (3 & 1)) == 3: 1
    return 0;
}
