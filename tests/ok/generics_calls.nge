// Generic functions that call each other, each call with its own types.
copy struct Pair<A, B> { a: A, b: B }

fn swap<A, B>(p: Pair<A, B>) -> Pair<B, A> { return Pair { a: p.b, b: p.a }; }
fn both<T>(x: T) -> Pair<T, T> { return Pair { a: x, b: x }; }
fn rot<A, B, C>(x: A, y: B, z: C) -> Pair<Pair<B, C>, A> { return Pair { a: Pair { a: y, b: z }, b: x }; }

fn main() -> i32 {
    let r = rot(1, true, 3);             // Pair<Pair<bool, i32>, i32>
    print(r.b);                          // 1
    if r.a.a { print(r.a.b); }           // 3
    let s = swap(swap(both(7)));
    print(s.a + s.b);                    // 14
    let t = swap(Pair { a: 2, b: false });
    print(t.b);                          // 2
    return 0;
}
