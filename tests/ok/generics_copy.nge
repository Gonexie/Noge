// A generic type declared `copy` is copy when everything it holds is: Pair<i32, i32> can be used again after
// being copied, Pair<Buf, i32> moves like Buf does.
struct Buf { len: i32 }
copy struct Pair<A, B> { a: A, b: B }
copy enum Option<T> { Some(T), None }

fn take<T>(x: sink T) -> T { return x; }

fn main() -> i32 {
    let p = Pair { a: 1, b: 2 };            // Pair<i32, i32>
    let q = p;                              // copied: p is still usable
    print(p.a + q.b);                       // 3
    let o = Option::Some(5);
    let o2 = o;                             // copied too
    print(match o { Option::Some(v) => v, Option::None => 0 } + match o2 { Option::Some(v) => v, Option::None => 0 });   // 10
    let r = Pair { a: Buf { len: 7 }, b: 1 };    // Pair<Buf, i32>: not copy
    let s = take(r);                        // moves r
    print(s.a.len);                         // 7
    let t = Option::Some(Buf { len: 9 });   // Option<Buf>: not copy
    match t {
        Option::Some(b) => { print(b.len); }      // 9
        Option::None => { print(0); }
    }
    return 0;
}
