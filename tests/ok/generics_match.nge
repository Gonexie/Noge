// A generic enum with two parameters, taken apart with match.
copy enum Res<T, E> { Ok(T), Err(E) }
copy enum Code { NotFound, Busy }

fn divide(a: i32, b: i32) -> Res<i32, Code> {
    if b == 0 { return Res::Err(Code::Busy); }
    return Res::Ok(a / b);
}

fn unwrap_or<T, E>(r: Res<T, E>, d: T) -> T {
    return match r {
        Res::Ok(v) => v,
        Res::Err(_) => d,
    };
}

fn code_of<T>(r: Res<T, Code>) -> i32 {
    return match r {
        Res::Ok(_) => 0,
        Res::Err(Code::NotFound) => 1,
        Res::Err(Code::Busy) => 2,
    };
}

fn main() -> i32 {
    print(unwrap_or(divide(10, 2), -1));    // 5
    print(unwrap_or(divide(1, 0), -1));     // -1
    print(code_of(divide(8, 4)));           // 0
    print(code_of(divide(8, 0)));           // 2
    let r: Res<bool, Code> = Res::Err(Code::NotFound);
    print(code_of(r));                      // 1
    return 0;
}
