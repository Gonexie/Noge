struct Tok { id: u32 }

fn bump(t: sink Tok) -> Tok { return Tok { id: t.id + 1 }; }

fn main() -> i32 {
    var t = Tok { id: 0 };
    var i = 0;
    while i < 3 {
        var j = 0;
        while j < 2 {
            t = bump(t);     // moved and put back on every iteration of both loops
            j = j + 1;
        }
        i = i + 1;
    }
    print(t.id as i32);      // 6

    var done = false;
    while !done {
        let u = Tok { id: 9 };   // declared inside the loop: a fresh value every iteration,
        let v = u;               // so moving it here is fine
        print(v.id as i32);
        done = true;
    }
    return 0;
}
