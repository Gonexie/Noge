// Operands, call arguments and struct-literal fields are evaluated left to right.
struct Q { x: i32, y: i32 }

fn bump(q: inout Q) -> i32 {
    q.x = q.x + 1;
    return q.x;
}

fn tri(a: i32, b: i32, c: i32) -> i32 { return a * 100 + b * 10 + c; }
// sink parameters take their values when the argument is evaluated; let ones stay borrowed until the call ends
fn tri_s(a: sink i32, b: sink i32, c: sink i32) -> i32 { return a * 100 + b * 10 + c; }

fn bump_i(x: inout i32) -> i32 {
    x = x + 1;
    return x;
}

// `v` is taken (copied) when the argument is evaluated, before `q` is borrowed.
fn add_to(v: sink i32, q: inout Q) { q.x = q.x + v; }

fn main() -> i32 {
    var q = Q { x: 1, y: 2 };
    let a = q.x + bump(&q);          // reads q.x (1) first, then bump makes it 2: 1 + 2
    print(a);                        // 3
    let b = bump(&q) + bump(&q);     // 3 + 4
    print(b);                        // 7

    var r = Q { x: 0, y: 0 };
    let c = Q { x: bump(&r), y: bump(&r) };   // fields run in source order
    print(c.x * 10 + c.y);           // 12
    let d = Q { y: bump(&r), x: bump(&r) };   // ...even when written in another order than declared
    print(d.x * 10 + d.y);           // 43
    print(tri(bump(&r), bump(&r), bump(&r)));  // 567

    add_to(q.x, &q);                 // the copy of q.x is made first: 4 + 4
    print(q.x);                      // 8

    // a plain variable read before a call that changes it keeps its old value
    var x = 1;
    let e = x + bump_i(&x);          // 1 + 2
    print(e);                        // 3
    var y = 10;
    let arr = [y, bump_i(&y), y];    // elements are evaluated in order: 10, 11, then y again (11)
    print(arr[0] * 10000 + arr[1] * 100 + arr[2]);   // 101111
    var z = 5;
    let w = tri_s(z, bump_i(&z), z); // 5, 6, 6
    print(w);                        // 566

    // `&&` and `||` evaluate the right side only when needed
    var hits = Q { x: 0, y: 0 };
    let t = true;
    let f = false;
    if f && bump(&hits) > 0 { }
    if t || bump(&hits) > 0 { }
    print(hits.x);                   // 0: neither call ran
    if t && bump(&hits) > 0 { }
    print(hits.x);                   // 1
    return 0;
}
