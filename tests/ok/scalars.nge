fn sign(x: i32) -> i32 {
    if x < 0 { return -1; } else if x == 0 { return 0; } else { return 1; }
}

fn main() -> i32 {
    let lo: i8 = -128;
    let hi: u8 = 255;
    print(lo as i32);
    print(hi as i32);
    print((hi as i32) + 1);
    print(sign(-7) + sign(0) * 10 + sign(9) * 100);
    let x = 5;
    {
        let x = x + 1;          // shadows in an inner block
        print(x);
    }
    print(x);
    let b = x > 3 && !(x == 9) || false;
    if b { print(1); } else { print(0); }
    print(true as i32);
    print(7 % 4 + 0x10);
    print(1 + (hi as i32));     // literal on the left adopts the right's type
    return 0;
}
